# MultiSub Panel configuration
# Copy this file to .env and replace example values before running.

# Panel administrator
PANEL_USERNAME=admin
PANEL_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
PANEL_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
# Keep true when using HTTPS. Use false only for temporary HTTP testing.
PANEL_COOKIE_SECURE=true

# Paths
# For a standalone installation, use a dedicated data directory.
MULTISUB_DATA_DIR=/var/lib/multisub-panel
MULTISUB_LOG_FILE=/var/log/multisub-panel/multisub.log

# Public base URL used to generate subscription links.
# Set this to your actual public URL, for example https://sub.example.com
# SUBSCRIPTION_BASE_URL=https://sub.example.com

# Application
PANEL_PORT=18082
APP_TEMPLATES_DIR=/opt/multisub-panel/templates
