#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONFIG_DIR="/etc/multisub-panel"
readonly MANIFEST="$CONFIG_DIR/managed-paths"
readonly UNIT_FILE="/etc/systemd/system/multisub-panel.service"
readonly NGINX_SITE="/etc/nginx/sites-available/multisub-panel"
readonly NGINX_LINK="/etc/nginx/sites-enabled/multisub-panel"
readonly COMMAND_FILE="/usr/local/sbin/subpanel"
readonly MARKER_NAME=".multisub-panel-managed"
readonly MARKER_TEXT="MultiSub Panel managed path v1"

fail() { printf '[ОШИБКА] %s\n' "$1" >&2; exit 1; }
info() { printf '[INFO] %s\n' "$1"; }

[[ "$EUID" -eq 0 ]] || fail "Запусти команду с sudo: sudo subpanel"
[[ -f "$MANIFEST" && ! -L "$MANIFEST" ]] || fail "Не найден манифест установки: $MANIFEST"
[[ "$(stat -c '%U:%G:%a' -- "$MANIFEST")" == "root:root:600" ]] ||
    fail "Манифест установки имеет небезопасного владельца или права."

# The root-only manifest is generated by the installer from validated paths.
# shellcheck disable=SC1090
source "$MANIFEST"

validate_path() {
    local name="$1" value="$2" current="/" component
    local -a parts
    [[ "$value" =~ ^/[A-Za-z0-9._/-]+$ && "$value" != "/" && "$value" != */ && "$value" != *//* ]] ||
        fail "В манифесте указан небезопасный путь $name: $value"
    IFS='/' read -r -a parts <<< "$value"
    for component in "${parts[@]}"; do
        [[ -z "$component" ]] && continue
        [[ "$component" != "." && "$component" != ".." ]] || fail "Недопустимый компонент пути $name."
        current="${current%/}/$component"
        [[ ! -L "$current" ]] || fail "Путь $name проходит через символическую ссылку: $current"
    done
}

validate_path APP_DIR "$APP_DIR"
validate_path DATA_DIR "$DATA_DIR"
validate_path LOG_DIR "$LOG_DIR"
validate_path BACKUP_DIR "$BACKUP_DIR"
[[ "$CONFIG_DIR" == "/etc/multisub-panel" ]] || fail "Неизвестный каталог конфигурации."
[[ "$SERVICE_USER" =~ ^[a-z_][a-z0-9_-]*[$]?$ && "$SERVICE_GROUP" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] ||
    fail "Недопустимое имя системной учётной записи в манифесте."
[[ "$PANEL_PORT" =~ ^[0-9]+$ ]] && (( PANEL_PORT >= 1 && PANEL_PORT <= 65535 )) ||
    fail "Недопустимый порт панели в манифесте."

require_marker() {
    local path="$1" marker="$1/$MARKER_NAME"
    [[ -d "$path" && ! -L "$path" ]] || fail "Каталог установки отсутствует или небезопасен: $path"
    [[ -f "$marker" && ! -L "$marker" ]] || fail "Нет маркера владения каталогом: $path"
    [[ "$(stat -c '%U:%G:%a' -- "$marker")" == "root:root:600" ]] ||
        fail "Маркера каталога небезопасны: $marker"
    [[ "$(cat -- "$marker")" == "$MARKER_TEXT" ]] || fail "Метка каталога не совпадает: $path"
}

show_status() {
    systemctl status --no-pager --full multisub-panel.service || true
}

health_check() {
    local failed=0 code
    printf 'Служба: '
    if systemctl is-active --quiet multisub-panel.service; then
        printf 'работает\n'
    else
        printf 'не работает\n'
        failed=1
    fi

    printf 'HTTP health endpoint: '
    code="$(curl --connect-timeout 3 --max-time 6 -sS -o /dev/null -w '%{http_code}' \
        "http://127.0.0.1:$PANEL_PORT/health" 2>/dev/null || true)"
    if [[ "$code" == "200" ]]; then
        printf 'HTTP %s OK\n' "$code"
    else
        printf 'ошибка (HTTP %s)\n' "${code:-нет ответа}"
        failed=1
    fi

    printf 'Конфигурация Nginx: '
    if nginx -t >/dev/null 2>&1; then
        printf 'корректна\n'
    else
        printf 'ошибка\n'
        nginx -t 2>&1 || true
        failed=1
    fi
    return "$failed"
}

change_credentials() {
    local current_user new_user password password_again rollback_file health_ok=0
    local config_file="$CONFIG_DIR/panel.env"
    [[ -f "$config_file" && ! -L "$config_file" ]] || fail "Не найдена конфигурация панели."
    [[ "$(stat -c '%U:%G:%a' -- "$config_file")" == "root:root:600" ]] ||
        fail "Конфигурация имеет небезопасного владельца или права."

    current_user="$(sed -n 's/^PANEL_USERNAME=//p' "$config_file" | head -n1)"
    printf 'Новый логин администратора (Enter — оставить %s): ' "$current_user"
    read -r new_user
    new_user="${new_user:-$current_user}"
    [[ "$new_user" =~ ^[a-zA-Z0-9_.-]{3,64}$ ]] || fail "Логин: 3–64 символа, латиница, цифры, точка, дефис или подчёркивание."

    read -r -s -p 'Новый пароль (12–128 символов: латиница, цифры, . _ ~ - @): ' password
    printf '\n'
    read -r -s -p 'Повтори новый пароль: ' password_again
    printf '\n'
    [[ "$password" == "$password_again" ]] || fail "Пароли не совпадают."
    [[ "$password" =~ ^[A-Za-z0-9._~@-]{12,128}$ ]] || fail "Пароль не соответствует требованиям."

    rollback_file="$(mktemp "$CONFIG_DIR/.panel.env.rollback.XXXXXX")"
    chmod 0600 "$rollback_file"
    cp --preserve=mode,ownership -- "$config_file" "$rollback_file"
    if ! PANEL_NEW_USERNAME="$new_user" PANEL_NEW_PASSWORD="$password" python3 - "$config_file" <<'PY'
import os
import tempfile
from pathlib import Path

path = Path(__import__("sys").argv[1])
lines = path.read_text(encoding="utf-8").splitlines()
values = {
    "PANEL_USERNAME": os.environ["PANEL_NEW_USERNAME"],
    "PANEL_PASSWORD": os.environ["PANEL_NEW_PASSWORD"],
    "PANEL_SECRET_KEY": __import__("secrets").token_urlsafe(48),
}
for key, value in values.items():
    matches = [i for i, line in enumerate(lines) if line.startswith(key + "=")]
    if len(matches) != 1:
        raise SystemExit(f"Ожидалась одна строка {key}= в конфигурации.")
    lines[matches[0]] = f"{key}={value}"

fd, temp_name = tempfile.mkstemp(prefix=".panel.env.", dir=path.parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        stream.write("\n".join(lines) + "\n")
    os.chown(temp_name, 0, 0)
    os.chmod(temp_name, 0o600)
    os.replace(temp_name, path)
except BaseException:
    try:
        os.unlink(temp_name)
    except FileNotFoundError:
        pass
    raise
PY
    then
        rm -f -- "$rollback_file"
        fail "Не удалось обновить конфигурацию."
    fi

    if ! systemctl restart multisub-panel.service; then
        cp --preserve=mode,ownership -- "$rollback_file" "$config_file"
        rm -f -- "$rollback_file"
        systemctl restart multisub-panel.service || true
        fail "Служба не перезапустилась; прежние настройки восстановлены."
    fi
    for _ in {1..15}; do
        if curl --connect-timeout 2 --max-time 4 -fsS -o /dev/null \
            "http://127.0.0.1:$PANEL_PORT/health"; then
            health_ok=1
            break
        fi
        sleep 1
    done
    if [[ "$health_ok" -ne 1 ]]; then
        cp --preserve=mode,ownership -- "$rollback_file" "$config_file"
        rm -f -- "$rollback_file"
        systemctl restart multisub-panel.service || true
        fail "Новая конфигурация не прошла проверку; прежние настройки восстановлены."
    fi
    rm -f -- "$rollback_file"
    printf '[OK] Данные входа обновлены для логина %s; активные сессии сброшены.\n' "$new_user"
}

uninstall_panel() {
    local reply uid gid backup unknown=0
    require_marker "$APP_DIR"
    require_marker "$DATA_DIR"
    require_marker "$LOG_DIR"
    [[ -d "$CONFIG_DIR" && ! -L "$CONFIG_DIR" ]] || fail "Каталог конфигурации отсутствует или небезопасен."
    [[ -f "$CONFIG_DIR/panel.env" && ! -L "$CONFIG_DIR/panel.env" ]] ||
        fail "Не найдена конфигурация панели. Удаление остановлено."

    [[ -f "$UNIT_FILE" && ! -L "$UNIT_FILE" ]] || fail "Не найден unit-файл службы."
    grep -Fq "EnvironmentFile=$CONFIG_DIR/panel.env" "$UNIT_FILE" || fail "Unit-файл не совпадает с манифестом."
    grep -Fq "ExecStart=$APP_DIR/run-panel.sh" "$UNIT_FILE" || fail "Unit-файл не совпадает с манифестом."

    [[ -f "$NGINX_SITE" && ! -L "$NGINX_SITE" ]] || fail "Не найден сайт Nginx панели."
    grep -Fq "proxy_pass http://127.0.0.1:$PANEL_PORT;" "$NGINX_SITE" ||
        fail "Конфигурация Nginx не совпадает с портом из манифеста."
    if [[ -e "$NGINX_LINK" || -L "$NGINX_LINK" ]]; then
        [[ -L "$NGINX_LINK" && "$(readlink -f -- "$NGINX_LINK")" == "$NGINX_SITE" ]] ||
            fail "Ссылка Nginx не ведёт на конфигурацию MultiSub Panel."
    fi

    uid="$(id -u "$SERVICE_USER" 2>/dev/null || true)"
    gid="$(getent group "$SERVICE_GROUP" | cut -d: -f3 || true)"
    [[ -n "$uid" && -n "$gid" ]] || fail "Системный пользователь или группа панели не найдены."
    [[ "$uid" == "$SERVICE_UID" && "$gid" == "$SERVICE_GID" ]] ||
        fail "Системные UID/GID отличаются от созданных при установке. Удаление остановлено."

    printf '\nБудут удалены файлы и данные панели:\n'
    printf '  приложение:       %s\n' "$APP_DIR"
    printf '  конфигурация:     %s\n' "$CONFIG_DIR"
    printf '  данные:           %s\n' "$DATA_DIR"
    printf '  журналы:          %s\n' "$LOG_DIR"
    printf '  резервные копии:  %s/multisub-panel-*.tar.gz\n' "$BACKUP_DIR"
    printf '  systemd-служба, сайт Nginx, команда и пользователь %s\n' "$SERVICE_USER"
    printf '\nИсходный каталог, из которого данные импортировали, не удаляется. Пакеты Nginx и Python и системный журнал не затрагиваются.\n'
    printf 'Для подтверждения введи УДАЛИТЬ ВСЁ: '
    read -r reply
    [[ "$reply" == "УДАЛИТЬ ВСЁ" ]] || { info "Удаление отменено."; return 0; }

    systemctl stop multisub-panel.service || fail "Не удалось остановить службу."
    systemctl disable multisub-panel.service || fail "Не удалось отключить службу."
    ! systemctl is-active --quiet multisub-panel.service || fail "Служба всё ещё активна; файлы не удалены."
    rm -f -- "$UNIT_FILE"
    systemctl daemon-reload
    systemctl reset-failed multisub-panel.service >/dev/null 2>&1 || true

    rm -f -- "$NGINX_LINK" "$NGINX_SITE"
    if systemctl is-active --quiet nginx; then
        if nginx -t; then systemctl reload nginx; else
            printf '[ПРЕДУПРЕЖДЕНИЕ] Nginx не перезагружен: проверьте оставшиеся конфигурации.\n' >&2
        fi
    fi

    rm -rf -- "$APP_DIR" "$CONFIG_DIR" "$DATA_DIR" "$LOG_DIR"

    if [[ -d "$BACKUP_DIR" && ! -L "$BACKUP_DIR" ]]; then
        shopt -s nullglob
        local -a backups=("$BACKUP_DIR"/multisub-panel-*.tar.gz)
        shopt -u nullglob
        for backup in "${backups[@]}"; do
            if [[ -f "$backup" && ! -L "$backup" ]]; then
                rm -f -- "$backup"
            else
                unknown=1
            fi
        done
        if (( unknown == 0 )); then
            if ! rmdir -- "$BACKUP_DIR" 2>/dev/null && [[ -d "$BACKUP_DIR" ]]; then
                unknown=1
            fi
        fi
        if (( unknown != 0 )); then
            printf '[ПРЕДУПРЕЖДЕНИЕ] В каталоге резервных копий остались неизвестные файлы: %s\n' "$BACKUP_DIR" >&2
        else
            :
        fi
    fi

    if pgrep -u "$uid" >/dev/null 2>&1; then
        printf '[ПРЕДУПРЕЖДЕНИЕ] У пользователя %s ещё есть процессы; учётная запись сохранена.\n' "$SERVICE_USER" >&2
    else
        userdel "$SERVICE_USER" || printf '[ПРЕДУПРЕЖДЕНИЕ] Не удалось удалить пользователя %s.\n' "$SERVICE_USER" >&2
        groupdel "$SERVICE_GROUP" 2>/dev/null ||
            printf '[ПРЕДУПРЕЖДЕНИЕ] Не удалось удалить группу %s.\n' "$SERVICE_GROUP" >&2
    fi
    rm -f -- "$COMMAND_FILE"
    printf '\n[ГОТОВО] Файлы, настройки и данные MultiSub Panel удалены. Системные журналы и общие пакеты сохранены.\n'
}

case "${1:-}" in
    --health) health_check; exit $? ;;
    --credentials) change_credentials; exit $? ;;
    --uninstall) uninstall_panel; exit $? ;;
    --help|-h)
        printf 'Использование: sudo subpanel [--health|--credentials|--uninstall]\n'
        exit 0
        ;;
    "") ;;
    *) fail "Неизвестный параметр: $1" ;;
esac

while true; do
    printf '\n=== MultiSub Panel ===\n'
    printf '1) Статус службы\n'
    printf '2) Проверить работоспособность\n'
    printf '3) Сменить логин и пароль администратора\n'
    printf '4) Полностью удалить MultiSub Panel и её данные\n'
    printf '0) Выход\n'
    printf 'Выбери действие: '
    read -r choice
    case "$choice" in
        1) show_status ;;
        2) health_check || true ;;
        3) change_credentials ;;
        4) uninstall_panel ;;
        0) exit 0 ;;
        *) printf 'Выбери 0, 1, 2, 3 или 4.\n' ;;
    esac
done